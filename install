#!/usr/bin/env bash
set -euo pipefail

DOTFILES="$(dirname "$(realpath "$0")")"

link() {
    local src="$DOTFILES/configs/$1"
    local dst="$HOME/$2"

    if [ ! -e "$src" ]; then
        echo "SKIP  $src (not found)"
        return
    fi

    if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
        echo "OK    $dst -> $src"
        return
    fi

    # keep a real file that differs instead of silently replacing it
    if [ -e "$dst" ] && [ ! -L "$dst" ] && ! cmp -s "$src" "$dst"; then
        local backup
        backup="$dst.backup-$(date +%Y%m%d-%H%M%S)"
        mv "$dst" "$backup"
        echo "SAVE  $dst -> $backup"
    fi

    mkdir -p "$(dirname "$dst")"
    ln -sfn "$src" "$dst"
    echo "LINK  $dst -> $src"
}

link gitconfig            .gitconfig
link gitignore_global     .gitignore_global
link allowed_signers      .config/git/allowed_signers
link starship.toml        .config/starship.toml
link zshenv               .zshenv
link zprofile             .zprofile
link zshrc                .zshrc
link vimrc                .vimrc
link ssh_config           .ssh/config
link claude/CLAUDE.md     .claude/CLAUDE.md
link claude/settings.json .claude/settings.json

# GOPATH in Go's own config file, so go and gopls use it even when started
# outside a login shell (GoLand, VS Code, Claude); otherwise they fall back to ~/go
if command -v go >/dev/null; then
    go env -w GOPATH="$HOME/Projects/Go"
    echo "SET   go env GOPATH=$HOME/Projects/Go"
fi
