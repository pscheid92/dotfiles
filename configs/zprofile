# Login shells read this once, before .zshrc. Exported environment goes here
# (PATH, tool homes, EDITOR, ...): child processes inherit it, including
# non-interactive `zsh -lc` commands. Interactive setup goes in .zshrc.

# no duplicate entries, also when a shell starts another one
typeset -U path fpath

export DOTFILES="${${(%):-%x}:A:h:h}"  # repo root, resolved through the ~/.zprofile symlink
for f ($DOTFILES/zsh/profile.d/*.zsh(.N)) source "$f"
unset f
