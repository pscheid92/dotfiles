[user]
	name = Patrick Scheid
	email = p.scheid92@gmail.com

[init]
	defaultBranch = main

[core]
	excludesfile = ~/.gitignore_global
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true  # n/N jump between files

[pull]
	rebase = true

[fetch]
	prune = true

[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true

[merge]
	conflictStyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = plain

[rerere]
	enabled = true

[branch]
	sort = -committerdate

[commit]
	verbose = true

[push]
	autoSetupRemote = true
	followTags = true

# machine-specific overrides (work email, ...), not tracked
[include]
	path = ~/.gitconfig.local
