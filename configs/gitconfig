[init]
	defaultBranch = main

[core]
	excludesfile = ~/.gitignore_global
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true  # n/N jump between files

[pull]
	rebase = true

[fetch]
	prune = true

[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true

[merge]
	conflictStyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = plain

[rerere]
	enabled = true

[branch]
	sort = -committerdate

[commit]
	verbose = true
	gpgsign = true

[tag]
	gpgsign = true

[push]
	autoSetupRemote = true
	followTags = true

# sign with the SSH key held by 1Password
[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed_signers

# machine-specific overrides (work email, ...), not tracked
[include]
	path = ~/.gitconfig.local
